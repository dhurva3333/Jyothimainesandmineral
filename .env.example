# Supabase project credentials.
# Without these set, the app runs in local/demo data mode — every
# demo-sourced value is labelled in the UI so it is never mistaken
# for a live database value.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: only needed if you enable monitoring/analytics.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_VERCEL_ANALYTICS=false
